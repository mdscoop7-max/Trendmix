{% extends "base.html" %}

{% block title %}
{% if category %}
{{ category }} - TrendMix
{% else %}
Shop - TrendMix
{% endif %}
{% endblock %}

{% block content %}

<section class="page-section shop-page">
<div class="section-header">

    <span class="section-label">
        TRENDMIX SHOP
    </span>

    <h1>
        {% if category %}
            {{ category }}
        {% else %}
            Ontdek iets nieuws
        {% endif %}
    </h1>

    <p>
        Ontdek populaire, handige en interessante producten
        voor tech, lifestyle en dagelijks gebruik.
    </p>

</div>


<!-- CATEGORIEÃ‹N -->

<nav class="category-nav">

    <a href="{{ url_for('shop') }}"
       class="{% if not category %}active{% endif %}">
        Alle
    </a>

    <a href="{{ url_for('shop', category='PC-Componenten') }}"
       class="{% if category == 'PC-Componenten' %}active{% endif %}">
        ðŸ–¥ï¸ PC Componenten
    </a>

    <a href="{{ url_for('shop', category='Gadgets') }}"
       class="{% if category == 'Gadgets' %}active{% endif %}">
        ðŸ”Œ Gadgets
    </a>

    <a href="{{ url_for('shop', category='Smart Home') }}"
       class="{% if category == 'Smart Home' %}active{% endif %}">
        ðŸ’¡ Smart Home
    </a>

    <a href="{{ url_for('shop', category='Beauty & Care') }}"
       class="{% if category == 'Beauty & Care' %}active{% endif %}">
        ðŸ’„ Beauty &amp; Care
    </a>

    <a href="{{ url_for('shop', category='Lifestyle & Sport') }}"
       class="{% if category == 'Lifestyle & Sport' %}active{% endif %}">
        âš½ Lifestyle &amp; Sport
    </a>

    <a href="{{ url_for('shop', category='Aanbiedingen') }}"
       class="{% if category == 'Aanbiedingen' %}active{% endif %}">
        ðŸ”¥ Aanbiedingen
    </a>

</nav>


<!-- ZOEKEN -->

<form
    action="{{ url_for('shop') }}"
    method="get"
    class="shop-search"
>

    {% if category %}
        <input
            type="hidden"
            name="category"
            value="{{ category }}"
        >
    {% endif %}

    <input
        type="search"
        name="q"
        value="{{ search or '' }}"
        placeholder="Zoek in deze collectie..."
        aria-label="Zoek producten"
    >

    <button type="submit">
        ðŸ”
    </button>

</form>


<!-- PRODUCT AANTAL -->

<div class="product-count">
    <strong>{{ products|length }}</strong>

    {% if products|length == 1 %}
        product gevonden
    {% else %}
        producten gevonden
    {% endif %}
</div>


<!-- PRODUCTEN -->

{% if products %}

<div class="product-grid">

    {% for product in products %}

    <article class="product-card">

        <a
            href="{{ url_for('product', product_id=product.id) }}"
            class="product-image"
        >

            {% if product.image %}

            <img
                src="{{ url_for('static', filename=product.image) }}"
                alt="{{ product.name }}"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            >

            <div
                class="product-placeholder"
                style="display:none;"
            >
                ðŸ›ï¸
            </div>

            {% else %}

            <div class="product-placeholder">
                ðŸ›ï¸
            </div>

            {% endif %}

        </a>


        <div class="product-info">

            {% if product.category %}

            <span class="product-category">
                {{ product.category }}
            </span>

            {% endif %}


            {% if product.badge %}

            <span class="product-badge">
                {{ product.badge }}
            </span>

            {% endif %}


            <h2>
                <a href="{{ url_for('product', product_id=product.id) }}">
                    {{ product.name }}
                </a>
            </h2>


            {% if product.description %}

            <p>
                {{ product.description }}
            </p>

            {% endif %}


            <div class="product-rating">

                {% if product.rating %}
                    â˜…â˜…â˜…â˜…â˜…
                    <span>
                        {{ product.rating }}
                        ({{ product.reviews }})
                    </span>
                {% else %}
                    â˜…â˜…â˜…â˜…â˜…
                {% endif %}

            </div>


            <div class="product-bottom">

                <div>

                    {% if product.old_price %}

                    <span class="old-price">
                        â‚¬{{ "%.2f"|format(product.old_price) }}
                    </span>

                    {% endif %}

                    <strong class="product-price">
                        â‚¬{{ "%.2f"|format(product.price) }}
                    </strong>

                </div>


                <a
                    href="{{ url_for('product', product_id=product.id) }}"
                    class="product-button"
                >
                    Bekijk â†’
                </a>

            </div>

        </div>

    </article>

    {% endfor %}

</div>

{% else %}

<div class="empty-shop">

    <div class="empty-icon">
        ðŸ”
    </div>

    <h2>
        Geen producten gevonden
    </h2>

    {% if search %}

    <p>
        We konden geen producten vinden voor
        <strong>"{{ search }}"</strong>.
    </p>

    {% else %}

    <p>
        Er zijn momenteel geen producten beschikbaar
        voor deze selectie.
    </p>

    {% endif %}

    <a
        href="{{ url_for('shop') }}"
        class="hero-btn"
    >
        ALLE PRODUCTEN
    </a>

</div>

{% endif %}
</section>

{% endblock %}

